{
  "$schema": "https://aka.ms/codetour-schema",
  "title": "Inventory Health — Senior Architecture Tour",
  "description": "A guided review of decision design, metric contracts, architecture trade-offs, operational controls, and leadership governance.",
  "isPrimary": true,
  "steps": [
    {
      "title": "How to use this tour",
      "description": "In about five minutes, follow the control tower from executive decision through metric contracts, trade-offs, release evidence, failure handling, and leadership governance. Separate observed evidence from proposed controls throughout."
    },
    {
      "title": "Start with the executive decision",
      "description": "The control tower balances service, working capital, network position, and capacity. The evidence boundary keeps observed structure separate from illustrative contracts and proposed controls.",
      "file": "README.md",
      "pattern": "^## Executive brief$"
    },
    {
      "title": "Follow the decision journey",
      "description": "Pages narrow from enterprise condition to a product-location action and each page has an explicit exit outcome. This is progressive disclosure for action, not a collection of visuals.",
      "file": "README.md",
      "pattern": "^## Decision journey$"
    },
    {
      "title": "Inspect metric contracts",
      "description": "Eligibility, grain, valuation, temporal cut-off, ownership, and breach actions make inventory metrics governable across reports and teams.",
      "file": "docs/metric-contracts.md",
      "pattern": "^## Shared grain and valuation contract$"
    },
    {
      "title": "Review architecture trade-offs",
      "description": "The ADRs expose rejected alternatives and consequences, including temporal separation, gross-versus-net risk, parameterized capacity thresholds, and environment binding.",
      "file": "docs/architecture-decisions.md",
      "pattern": "^# Architecture decisions$"
    },
    {
      "title": "Test as a release gate",
      "description": "The matrix makes reconciliation, bucket exclusivity, security, accessibility, and performance release-blocking with named evidence and ownership.",
      "file": "docs/testing.md",
      "pattern": "^# Release-blocking test matrix$"
    },
    {
      "title": "Handle failure and scale",
      "description": "Decision rights, failure modes, incident flow, and the 10× scale discussion turn the dashboard into an operated analytical product.",
      "file": "docs/operating-model.md",
      "pattern": "^# Operating model and failure handling$"
    },
    {
      "title": "Challenge the DAX assumptions",
      "description": "Synthetic patterns show lifecycle-stage de-duplication, closed periods, gross risk visibility, governed thresholds, and hysteresis without exposing proprietary measures.",
      "file": "samples/dax-patterns.md",
      "pattern": "^## Commitment value without stage double counting$"
    },
    {
      "title": "Close with a defensible interview path",
      "description": "Use the short and five-minute narratives, then answer challenge questions with explicit evidence language. Do not claim personal ownership or production impact without approved evidence.",
      "file": "docs/interview-guide.md",
      "pattern": "^## 30-second answer$"
    },
    {
      "title": "Translate architecture into leadership",
      "description": "You have followed the product from decision framing through metric contracts, trade-offs, release evidence, failure handling, and interview defense. A Senior/Lead discussion should connect each technical choice to decision quality, accountable ownership, and a safe rollback path. Continue with the semantic-model and medallion-platform case studies for shared metrics and end-to-end lineage."
    }
  ]
}
